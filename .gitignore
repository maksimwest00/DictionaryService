# Общие правила для всего монорепозитория (backend + frontend)
# Специфичные правила лежат в:
#   - DictionaryService/.gitignore  (backend, .NET)
#   - frontend/.gitignore           (frontend, Node/Next.js)

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# --- Windows ---
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# --- Linux ---
*~

# --- Редакторы / IDE ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# --- Vim ---
*.swp

# --- Прочее ---
*.log
